APP_NAME=Monitor
APP_URL=http://localhost:8080
# Buat dengan:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Nama & hostname yang tampil di dashboard
MONITOR_SERVER_NAME="Server 2"
MONITOR_HOSTNAME=server-2

# Akun login pertama
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Token agent: dipakai Server 1 untuk membaca metrik & terminal Server 2.
# Buat dengan:  openssl rand -hex 32
AGENT_TOKEN=
# true = dashboard Server 1 boleh membuka terminal di server ini
AGENT_ALLOW_EXEC=true

# Terminal di server ini
TERMINAL_ENABLED=true
# Jalankan perintah di HOST lewat SSH (kosongkan untuk menjalankan di dalam container saja)
TERMINAL_SSH_HOST=
TERMINAL_SSH_USER=
TERMINAL_SSH_PORT=22
TERMINAL_SSH_KEY=/ssh/id_ed25519

# Link Portainer server ini (opsional)
PORTAINER_URL=
